# detector: build from the repository root, for example:
#   docker build -f deploy/docker/Dockerfile.detector -t huntcopilot/detector:dev .
# The start command on the last line is the only service-specific line besides the port.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HC_SERVICE=detector
RUN useradd --create-home --uid 10001 hc && mkdir -p /data && chown hc:hc /data
WORKDIR /app
COPY common/ /app/common/
COPY libs/ /app/libs/
COPY services/detector/ /app/services/detector/
RUN pip install --no-cache-dir -r /app/services/detector/requirements.txt
ENV PYTHONPATH=/app/common:/app/libs:/app/services/detector
USER hc
EXPOSE 8200
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8200/health', timeout=2)"
CMD ["sh", "-c", "exec python -m main"]
