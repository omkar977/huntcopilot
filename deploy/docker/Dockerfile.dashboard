# dashboard: build from the repository root, for example:
#   docker build -f deploy/docker/Dockerfile.dashboard -t huntcopilot/dashboard:dev .
# The start command on the last line is the only service-specific line besides the port.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HC_SERVICE=dashboard
RUN useradd --create-home --uid 10001 hc && mkdir -p /data && chown hc:hc /data
WORKDIR /app
COPY common/ /app/common/
COPY libs/ /app/libs/
COPY services/dashboard/ /app/services/dashboard/
RUN pip install --no-cache-dir -r /app/services/dashboard/requirements.txt
ENV PYTHONPATH=/app/common:/app/libs:/app/services/dashboard
USER hc
EXPOSE 8501
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8501/_stcore/health', timeout=2)"
CMD ["sh", "-c", "exec streamlit run /app/services/dashboard/app.py --server.port=8501 --server.address=0.0.0.0 --server.headless=true"]
