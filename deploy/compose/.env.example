# Copy to .env and fill in. NEVER commit .env or share real keys.
HC_ENV=dev
HC_LOG_LEVEL=INFO
HC_REDIS_URL=redis://redis:6379/0
HC_OPENSEARCH_URL=http://opensearch:9200
HC_EVENTS_INDEX_PREFIX=hc-events
HC_ALERTS_INDEX=hc-alerts
HC_FINDINGS_INDEX=hc-findings
# Required: shared key for the X-API-Key header. Use a long random string.
HC_API_KEY=<set-a-long-random-string>
HC_API_URL=http://api:8000
HC_ML_URL=http://ml:8100
HC_GENERATOR_URL=http://generator:8300
HC_DB_URL=sqlite:////data/hc.db
HC_AUDIT_PATH=/data/audit.jsonl
HC_MODEL_DIR=/data/models
HC_MLFLOW_URI=file:///data/mlruns
# LLM is optional. Leave LLM_PROVIDER=none to use the deterministic fallback.
# Gemini (Google AI Studio key): LLM_PROVIDER=gemini, LLM_API_KEY=<your key>, LLM_MODEL=<a Flash model name from AI Studio>, leave LLM_BASE_URL empty.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20
# Compose only: pin the OpenSearch 2.x image. Check that this tag has an arm64 variant before building.
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.17.1
